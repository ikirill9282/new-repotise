{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "filament/filament": "^3.3",
        "google/analytics-data": "^0.23.1",
        "google/apiclient": "^2.18",
        "http-interop/http-factory-guzzle": "^1.2",
        "intervention/image": "^2.7",
        "laravel/cashier": "^15.6",
        "laravel/framework": "^12.0",
        "laravel/scout": "^10.14",
        "laravel/socialite": "^5.23",
        "laravel/tinker": "^2.10.1",
        "livewire/livewire": "^3.6",
        "malzariey/filament-daterangepicker-filter": "^4.0",
        "meilisearch/meilisearch-php": "^1.13",
        "mews/purifier": "^3.4",
        "opcodesio/log-viewer": "^3.15",
        "pragmarx/google2fa-laravel": "^2.3",
        "romanzipp/laravel-queue-monitor": "^5.4",
        "spatie/image-optimizer": "^1.6",
        "spatie/laravel-permission": "^6.16",
        "symfony/http-client": "^7.2",
        "symfony/mailgun-mailer": "^7.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/dusk": "^8.3",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload": {
        "files": [
          "app/Helpers/functions.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "php artisan test"
        ],
        "test:unit": [
            "php artisan test --testsuite=Unit"
        ],
        "test:feature": [
            "php artisan test --testsuite=Feature"
        ],
        "test:coverage": [
            "php artisan test --coverage"
        ],
        "test:parallel": [
            "php artisan test --parallel"
        ],
        "test:dusk": [
            "php artisan dusk"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": false,
            "php-http/discovery": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
